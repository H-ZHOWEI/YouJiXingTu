<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ 的 edge-to-edge 完全由代码 InsetsUtil 手动处理系统栏 padding，
         这里不设置 windowOptOutEdgeToEdgeEnforcement，避免与手动 insets 方案相互干扰。
         内容与主题定义与 values/styles.xml 保持一致。 -->
    <style name="Theme.YouJiStarMap" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/darker</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/darker</item>
        <item name="android:textColorPrimary">@color/light</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/darker</item>
        <item name="android:statusBarColor">@color/darker</item>
        <item name="android:navigationBarColor">@color/darker</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
