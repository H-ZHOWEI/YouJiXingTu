<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择加油站"
        android:textColor="@color/light"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nearbyStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="正在定位..."
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/nearbyProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="附近加油站（5 公里内，点击选择）"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/nearbyListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="@color/primary"
        android:dividerHeight="1dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="没有合适的？手动输入加油站名称"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/nearbyManualInput"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="输入加油站名称"
        android:inputType="text"
        android:paddingStart="10dp"
        android:textColor="@color/light"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nearbyCancelBtn"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:text="取消"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/nearbyConfirmBtn"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="使用此名称"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
