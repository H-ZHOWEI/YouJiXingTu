<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView style="@style/CardTitle" android:text="🛰️ 星迹记录" />

            <TextView style="@style/LabelText" android:layout_marginTop="10dp" android:text="日期时间 *" />
            <Button
                android:id="@+id/dateBtn"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_field"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:textColor="@color/light"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/lockDateTimeCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="锁定日期时间（防止自动更新）"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView style="@style/LabelText" android:layout_marginTop="6dp" android:text="当前油表公里数 *" />
            <EditText
                android:id="@+id/mileageInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_field"
                android:hint="请输入当前公里数"
                android:inputType="number"
                android:paddingStart="10dp"
                android:textColor="@color/light"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/forgotMileageCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我忘记了"
                android:textColor="@color/average"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mileageError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/poor"
                android:textSize="12sp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/refuelCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⛽ 本次加油了"
                android:textColor="@color/light"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/fuelDetailsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <TextView style="@style/LabelText" android:text="加油站名称 *" />
                <EditText
                    android:id="@+id/gasStationInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_field"
                    android:hint="请输入加油站名称"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/forgotGasStationCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我忘记了"
                    android:textColor="@color/average"
                    android:textSize="12sp" />
                <TextView android:id="@+id/gasStationError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请填写加油站名称" android:textColor="@color/poor" android:textSize="12sp" android:visibility="gone" />

                <TextView style="@style/LabelText" android:layout_marginTop="6dp" android:text="加油量（升）*" />
                <EditText
                    android:id="@+id/fuelLitersInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_field"
                    android:hint="请输入加油量"
                    android:inputType="numberDecimal"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/forgotFuelLitersCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我忘记了"
                    android:textColor="@color/average"
                    android:textSize="12sp" />
                <TextView android:id="@+id/fuelLitersError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请填写加油量" android:textColor="@color/poor" android:textSize="12sp" android:visibility="gone" />

                <TextView style="@style/LabelText" android:layout_marginTop="6dp" android:text="加油金额（元）*" />
                <EditText
                    android:id="@+id/fuelCostInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_field"
                    android:hint="请输入加油金额"
                    android:inputType="numberDecimal"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/forgotFuelCostCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我忘记了"
                    android:textColor="@color/average"
                    android:textSize="12sp" />
                <TextView android:id="@+id/fuelCostError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请填写加油金额" android:textColor="@color/poor" android:textSize="12sp" android:visibility="gone" />

                <TextView style="@style/LabelText" android:layout_marginTop="6dp" android:text="油品类型 *" />
                <Spinner
                    android:id="@+id/fuelTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_field"
                    android:entries="@array/fuel_types"
                    android:spinnerMode="dialog" />
                <CheckBox
                    android:id="@+id/forgotFuelTypeCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我忘记了"
                    android:textColor="@color/average"
                    android:textSize="12sp" />
                <TextView android:id="@+id/fuelTypeError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请选择油品类型" android:textColor="@color/poor" android:textSize="12sp" android:visibility="gone" />

                <TextView style="@style/LabelText" android:layout_marginTop="6dp" android:text="油箱状态" />
                <RadioGroup
                    android:id="@+id/tankStatusGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/tankFullRadio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="加满"
                        android:textColor="@color/light"
                        android:textSize="13sp" />
                    <RadioButton
                        android:id="@+id/tankPartialRadio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="部分加油"
                        android:textColor="@color/light"
                        android:textSize="13sp" />
                </RadioGroup>

                <TextView style="@style/LabelText" android:layout_marginTop="8dp" android:text="油表格数（选填，填得越多估算越准）" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/gaugeBeforeInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:hint="加油前格数"
                        android:inputType="numberDecimal"
                        android:paddingStart="10dp"
                        android:textColor="@color/light"
                        android:textColorHint="@color/muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/gaugeAfterInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:hint="加油后格数"
                        android:inputType="numberDecimal"
                        android:paddingStart="10dp"
                        android:textColor="@color/light"
                        android:textColorHint="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/gaugeNowInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:hint="当前格数（不加油时也可单独更新）"
                    android:inputType="numberDecimal"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/smartHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_banner"
                    android:padding="8dp"
                    android:textColor="@color/average"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView style="@style/LabelText" android:layout_marginTop="8dp" android:text="去了哪里 *" />
            <AutoCompleteTextView
                android:id="@+id/destinationInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_field"
                android:hint="请输入目的地（输入时提示常用地点）"
                android:inputType="text"
                android:paddingStart="10dp"
                android:textColor="@color/light"
                android:textColorHint="@color/muted"
                android:textSize="14sp"
                android:completionThreshold="1"
                android:dropDownHeight="180dp" />
            <TextView
                android:id="@+id/destinationError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="请填写目的地"
                android:textColor="@color/poor"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="💾 保存记录"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fuelEstimateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView style="@style/CardTitle" android:text="🧮 油量估算" />

            <TextView
                android:id="@+id/estimatedFuelText"
                style="@style/ValueText"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="-- 升" />
            <TextView style="@style/LabelText" android:layout_gravity="center_horizontal" android:text="当前油箱剩余油量" android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_gauge">

                <ProgressBar
                    android:id="@+id/fuelGauge"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="100"
                    android:progressDrawable="@drawable/fuel_progress" />

                <TextView
                    android:id="@+id/fuelPercentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="0%"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/remainingDistanceText"
                style="@style/LabelText"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="可行驶距离: -- 公里"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/remainingValueText"
                style="@style/LabelText"
                android:layout_gravity="center_horizontal"
                android:text="当前油量价值: -- 元"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/estimatedTankCapacityText"
                style="@style/LabelText"
                android:layout_gravity="center_horizontal"
                android:text="估算油箱容量: -- 升"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/gaugeDetailText"
                style="@style/LabelText"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textColor="@color/average"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/gaugeCurrentInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:hint="当前油表格数（选填）"
                    android:inputType="numberDecimal"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/saveGaugeCurrentBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_ghost"
                    android:text="更新"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/manualTankCapacityInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:hint="手动设置油箱容量（升）"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/saveTankCapacityBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_ghost"
                    android:text="保存"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/gaugeTotalInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:hint="油表总格数（默认12）"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/saveGaugeTotalBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_ghost"
                    android:text="保存"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- v1.15 车载蓝牙自动启动 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView style="@style/CardTitle" android:text="🚗 车载蓝牙自动启动" />

            <!-- v1.19 整套方案总开关 -->
            <CheckBox
                android:id="@+id/btMasterCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="由本软件自动打开（关闭则交给手机系统自带功能，本软件不耗电）"
                android:textColor="@color/light"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="推荐点「选择设备」直接挑车机（自动记 MAC，最可靠）。以后手机一连上这个蓝牙，就会自动打开本软件。连上没反应的话点「测试配置」看差哪一步。"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/btNameInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:hint="蓝牙名称（如：蓝牙A）"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:textColor="@color/light"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btSaveBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_ghost"
                    android:text="保存"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/btEnabledCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用：连接该蓝牙后自动打开"
                    android:textColor="@color/light"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btOverlayBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button_ghost"
                    android:text="授权悬浮窗"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btPickDeviceBtn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_ghost"
                    android:text="选择设备"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btTestBtn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_ghost"
                    android:text="测试配置"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/btKeepAliveCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="后台保活（必须开：防止系统冻结后收不到蓝牙广播，通知栏会常驻一条通知）"
                android:textColor="@color/light"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/average"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btDiagText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/avgConsumptionText" style="@style/ValueText" android:text="--" />
                <TextView style="@style/LabelText" android:text="平均油耗" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/monthCostText" style="@style/ValueText" android:text="--" />
                <TextView style="@style/LabelText" android:text="本月油费" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/monthDistanceText" style="@style/ValueText" android:text="--" />
                <TextView style="@style/LabelText" android:text="本月里程" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
