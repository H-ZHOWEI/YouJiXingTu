<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView style="@style/CardTitle" android:text="⛽ 加油站对比" />
    <TextView style="@style/LabelText" android:layout_marginTop="4dp" android:text="只统计加满油且数据完整的记录" android:textSize="12sp" />

    <TextView
        android:id="@+id/stationEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="暂无加油站对比数据，请添加完整加油记录"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stationsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />
</LinearLayout>
