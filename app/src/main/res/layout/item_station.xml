<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/stationNameText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="加油站" android:textColor="@color/primary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/stationCountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 次" android:textColor="@color/muted" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/stationConsumptionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/light" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="平均油耗" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/stationPriceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/light" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="平均油价" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/stationLitersText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/light" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="平均加油量" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/stationRatingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/good" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="综合评分" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/stationTypesText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="油品: --" android:textColor="@color/muted" android:textSize="11sp" />
</LinearLayout>
