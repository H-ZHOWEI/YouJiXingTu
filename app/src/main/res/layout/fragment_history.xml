<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1" android:text="🛰️ 星迹历史" />
            <Button
                android:id="@+id/deleteAllBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_danger"
                android:text="清除星迹"
                android:textColor="@color/danger"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/exportBtn" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_button_ghost" android:text="导出星图" android:textColor="@color/primary" android:textSize="12sp" />
            <Button android:id="@+id/importBtn" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_button_ghost" android:text="导入星图" android:textColor="@color/primary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView style="@style/LabelText" android:layout_width="0dp" android:layout_weight="1" android:text="当前记录数" android:textSize="12sp" />
            <TextView android:id="@+id/recordCountText" style="@style/LabelText" android:text="0" android:textColor="@color/primary" android:textSize="12sp" />
            <TextView style="@style/LabelText" android:layout_marginStart="16dp" android:layout_width="0dp" android:layout_weight="1" android:text="存储使用量" android:textSize="12sp" />
            <TextView android:id="@+id/storageUsageText" style="@style/LabelText" android:text="-- KB" android:textColor="@color/primary" android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/cleanRedundantBtn"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_ghost"
            android:text="🧹 清理冗余记录"
            android:textColor="@color/average"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button android:id="@+id/prevPageBtn" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_button_ghost" android:text="上一页" android:textColor="@color/muted" android:textSize="12sp" />
        <TextView android:id="@+id/pageInfoText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="第 1 页 / 共 1 页" android:textColor="@color/light" android:textSize="12sp" />
        <Button android:id="@+id/nextPageBtn" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_button_ghost" android:text="下一页" android:textColor="@color/muted" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
