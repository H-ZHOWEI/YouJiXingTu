<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemDateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026-01-01 12:00"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="horizontal">
            <TextView
                android:id="@+id/itemMileageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 km"
                android:textColor="@color/light"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/itemBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:text="加满"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/itemDestinationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="目的地: --"
            android:textColor="@color/light"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/itemRefuelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/average"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
        <Button android:id="@+id/itemEditBtn" android:layout_width="42dp" android:layout_height="34dp" android:background="@drawable/bg_button_ghost" android:text="改" android:textColor="@color/primary" android:textSize="12sp" />
        <Button android:id="@+id/itemDeleteBtn" android:layout_width="42dp" android:layout_height="34dp" android:layout_marginTop="6dp" android:background="@drawable/bg_button_danger" android:text="删" android:textColor="@color/danger" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
